{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/favicon.(ico|svg|png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/tracking/:trackingNumber", "destination": "/api/tracking/[trackingNumber]" },
    { "source": "/api/tracking-search", "destination": "/api/tracking-search" },
    { "source": "/api/v1/deliveries/resend-email", "destination": "/api/v1/deliveries/resend-email" },
    { "source": "/api/deliveries/resend-email", "destination": "/api/deliveries/resend-email" },
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/inventory.html", "destination": "/inventory.html" },
    { "source": "/inventory", "destination": "/inventory.html" },
    { "source": "/it.html", "destination": "/it.html" },
    { "source": "/it", "destination": "/it.html" },
    { "source": "/marketing.html", "destination": "/marketing.html" },
    { "source": "/marketing", "destination": "/marketing.html" },
    { "source": "/insights.html", "destination": "/insights.html" },
    { "source": "/insights", "destination": "/insights.html" },
    { "source": "/logistics.html", "destination": "/logistics.html" },
    { "source": "/logistics", "destination": "/logistics.html" },
    { "source": "/project-wizards.html", "destination": "/project-wizards.html" },
    { "source": "/project-wizards", "destination": "/project-wizards.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}

